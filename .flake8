[flake8]
# Длина строки соответствует Black (88 символов)
max-line-length = 88
# E501 игнорируется, так как Black уже форматирует код
# E203, E266 игнорируются для совместимости с Black
extend-ignore = E203, E266, E501, W503
exclude =
    .git,
    __pycache__,
    migrations,
    venv,
    env,
    .venv,
    .env,
    build,
    dist,
    *.egg-info
per-file-ignores =
    __init__.py:F401

